# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# CLERK — primary browser authentication.
# VITE_CLERK_PUBLISHABLE_KEY is public and safe for browser bundles.
# In Clerk Dashboard > Integrations, create a Firebase JWT template named "firebase".
# The template should include the Firebase issuer/audience claims required by your Firebase project.
VITE_CLERK_PUBLISHABLE_KEY="pk_test_MIST_CLERK_PUBLISHABLE_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PUBLIC_APP_URL: Optional short custom domain for published sites (e.g. https://sites.example.com).
# Published projects resolve directly at /<slug> on this origin.
PUBLIC_APP_URL=""

# MIST_VAULT_SECRET: Optional 32+ char server secret used with HKDF to seal user BYOK vaults.
# If omitted, Mist derives a deterministic server secret bound to the runtime Firebase project.
MIST_VAULT_SECRET=""

# VAPID Keys for Web Push Notifications:
# In Google AI Studio (mistdev.ai.studio):
# Add these in the "Secrets" / "Environment Variables" panel in the AI Studio editor sidebar.
# If omitted, Mist automatically generates runtime keys on startup so notifications work out-of-the-box!
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@mistdev.ai.studio"
