rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Core primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isVerifiedUser() && request.auth.uid == uid;
    }

    // Entity validators
    function isValidUserProfile(data, userId) {
      return data.uid is string
        && isValidId(data.uid)
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 254
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 120
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 512 && data.photoURL.matches('^https://.*')))
        && (!('preferredProvider' in data) || (data.preferredProvider in ['gemini', 'openrouter', 'groq', 'custom']))
        && (!('preferredModel' in data) || (data.preferredModel is string && data.preferredModel.size() <= 120))
        && (!('theme' in data) || (data.theme in ['dark', 'light']))
        && (!('defaultViewMode' in data) || (data.defaultViewMode in ['preview', 'visual', 'code', 'split']))
        && (!('defaultViewport' in data) || (data.defaultViewport in ['desktop', 'tablet', 'mobile']))
        && (!('enableAppAi' in data) || (data.enableAppAi is bool))
        && (!('appAiMode' in data) || (data.appAiMode in ['on_request', 'always', 'off']))
        && (!('webSearchMode' in data) || (data.webSearchMode in ['auto', 'on', 'off']))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMistProject(data, projectId) {
      return data.id is string
        && isValidId(data.id)
        && data.id == projectId
        && data.ownerId is string
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 120
        && (!('description' in data) || (data.description is string && data.description.size() <= 500))
        && data.prompt is string
        && data.prompt.size() <= 4000
        && (!('templateId' in data) || (data.templateId is string && data.templateId.size() <= 64))
        && (!('appAiEnabled' in data) || (data.appAiEnabled is bool))
        && (!('publishedSlug' in data) || (data.publishedSlug is string && data.publishedSlug.size() <= 80 && data.publishedSlug.matches('^[a-zA-Z0-9_\\-]*$')))
        && data.isPublished is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidProjectFile(data, projectId, fileId) {
      return data.id is string
        && isValidId(data.id)
        && data.id == fileId
        && data.projectId is string
        && isValidId(data.projectId)
        && data.projectId == projectId
        && data.ownerId is string
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.path is string
        && data.path.size() >= 1
        && data.path.size() <= 256
        && data.language in ['tsx', 'ts', 'css', 'html', 'json']
        && data.content is string
        && data.content.size() <= 200000
        && data.updatedAt is timestamp;
    }

    function isValidCredentialVault(data, userId) {
      return data.ownerId is string
        && isValidId(data.ownerId)
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && data.boundEmail is string
        && data.boundEmail.size() >= 3
        && data.boundEmail.size() <= 254
        && request.auth.token.email is string
        && data.boundEmail == request.auth.token.email
        && data.algorithm == 'AES-256-GCM'
        && data.ciphertext is string
        && data.ciphertext.size() >= 1
        && data.ciphertext.size() <= 16384
        && (!('aiKeyHint' in data) || (data.aiKeyHint is string && data.aiKeyHint.size() <= 32))
        && (!('searchKeyHint' in data) || (data.searchKeyHint is string && data.searchKeyHint.size() <= 32))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidProjectMessage(data, projectId, messageId) {
      return data.id is string
        && isValidId(data.id)
        && data.id == messageId
        && data.projectId is string
        && isValidId(data.projectId)
        && data.projectId == projectId
        && data.ownerId is string
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.role in ['user', 'assistant']
        && data.content is string
        && data.content.size() <= 24000
        && data.seq is int
        && data.seq >= 0
        && data.seq <= 100000
        && data.timestamp is string
        && data.timestamp.size() >= 1
        && data.timestamp.size() <= 64
        && (!('changedFiles' in data) || (data.changedFiles is list && data.changedFiles.size() <= 120 && (data.changedFiles.size() == 0 || data.changedFiles[0] is string)))
        && (!('searchOutcome' in data) || (data.searchOutcome is map && data.searchOutcome.keys().hasOnly(['status', 'queries', 'sources', 'citedIds', 'warning', 'error', 'searchedAt', 'providerName'])))
        && data.updatedAt is timestamp;
    }

    function isValidDeployment(data, slug) {
      return data.slug is string
        && data.slug.size() >= 2
        && data.slug.size() <= 80
        && data.slug.matches('^[a-zA-Z0-9_\\-]+$')
        && data.slug == slug
        && data.ownerId is string
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.projectId is string
        && isValidId(data.projectId)
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 120
        && data.htmlBundle is string
        && data.htmlBundle.size() >= 1
        && data.htmlBundle.size() <= 900000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Users collection (PII isolated strictly to owner)
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().keys().hasAll(['uid', 'email', 'displayName', 'createdAt', 'updatedAt'])
        && incoming().keys().hasOnly([
          'uid', 'email', 'displayName', 'photoURL', 'preferredProvider',
          'preferredModel', 'theme', 'defaultViewMode', 'defaultViewport',
          'enableAppAi', 'appAiMode', 'webSearchMode', 'createdAt', 'updatedAt'
        ])
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'photoURL', 'preferredProvider',
          'preferredModel', 'theme', 'defaultViewMode', 'defaultViewport',
          'enableAppAi', 'appAiMode', 'webSearchMode', 'email', 'updatedAt'
        ]);
      allow delete: if isValidId(userId) && isOwner(userId);

      // Private account-bound encrypted BYOK credential vault
      match /private/{vaultId} {
        allow get: if isValidId(userId) && vaultId == 'credentials' && isOwner(userId);
        allow list: if false;
        allow create: if isVerifiedUser()
          && isValidId(userId)
          && vaultId == 'credentials'
          && isOwner(userId)
          && isValidCredentialVault(incoming(), userId)
          && incoming().keys().hasAll(['ownerId', 'boundEmail', 'algorithm', 'ciphertext', 'createdAt', 'updatedAt'])
          && incoming().keys().hasOnly([
            'ownerId', 'boundEmail', 'algorithm', 'ciphertext',
            'aiKeyHint', 'searchKeyHint', 'createdAt', 'updatedAt'
          ])
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isVerifiedUser()
          && isValidId(userId)
          && vaultId == 'credentials'
          && isOwner(userId)
          && isValidCredentialVault(incoming(), userId)
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'boundEmail', 'algorithm', 'ciphertext', 'aiKeyHint', 'searchKeyHint', 'updatedAt'
          ]);
        allow delete: if isValidId(userId) && vaultId == 'credentials' && isOwner(userId);
      }
    }

    // Projects collection
    match /projects/{projectId} {
      allow get: if isValidId(projectId)
        && isVerifiedUser()
        && existing().ownerId == request.auth.uid;
      allow list: if isVerifiedUser()
        && resource.data.ownerId == request.auth.uid;
      allow create: if isVerifiedUser()
        && isValidId(projectId)
        && isValidMistProject(incoming(), projectId)
        && incoming().keys().hasAll(['id', 'ownerId', 'name', 'prompt', 'isPublished', 'createdAt', 'updatedAt'])
        && incoming().keys().hasOnly(['id', 'ownerId', 'name', 'description', 'prompt', 'templateId', 'appAiEnabled', 'publishedSlug', 'isPublished', 'createdAt', 'updatedAt'])
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(projectId)
        && existing().ownerId == request.auth.uid
        && isValidMistProject(incoming(), projectId)
        && incoming().id == existing().id
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['prompt', 'appAiEnabled', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['publishedSlug', 'isPublished', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'prompt', 'appAiEnabled', 'publishedSlug', 'isPublished', 'updatedAt'])
        );
      allow delete: if isValidId(projectId)
        && isVerifiedUser()
        && existing().ownerId == request.auth.uid;

      // Subcollection: project source files (Master Gate via parent project)
      match /files/{fileId} {
        allow get: if isValidId(projectId)
          && isValidId(fileId)
          && isVerifiedUser()
          && exists(/databases/$(database)/documents/projects/$(projectId))
          && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
        allow list: if isVerifiedUser()
          && resource.data.ownerId == request.auth.uid;
        allow create: if isVerifiedUser()
          && isValidId(projectId)
          && isValidId(fileId)
          && isValidProjectFile(incoming(), projectId, fileId)
          && incoming().keys().hasAll(['id', 'projectId', 'ownerId', 'path', 'language', 'content', 'updatedAt'])
          && incoming().keys().hasOnly(['id', 'projectId', 'ownerId', 'path', 'language', 'content', 'updatedAt'])
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/projects/$(projectId))
          && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
        allow update: if isVerifiedUser()
          && isValidId(projectId)
          && isValidId(fileId)
          && isValidProjectFile(incoming(), projectId, fileId)
          && incoming().id == existing().id
          && incoming().projectId == existing().projectId
          && incoming().ownerId == existing().ownerId
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['path', 'language', 'content', 'updatedAt'])
          && exists(/databases/$(database)/documents/projects/$(projectId))
          && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
        allow delete: if isValidId(projectId)
          && isValidId(fileId)
          && isVerifiedUser()
          && exists(/databases/$(database)/documents/projects/$(projectId))
          && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
      }

      // Subcollection: project chat & refinement history (Master Gate via parent project)
      match /messages/{messageId} {
        allow get: if isValidId(projectId)
          && isValidId(messageId)
          && isVerifiedUser()
          && exists(/databases/$(database)/documents/projects/$(projectId))
          && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
        allow list: if isVerifiedUser()
          && resource.data.ownerId == request.auth.uid;
        allow create: if isVerifiedUser()
          && isValidId(projectId)
          && isValidId(messageId)
          && isValidProjectMessage(incoming(), projectId, messageId)
          && incoming().keys().hasAll(['id', 'projectId', 'ownerId', 'role', 'content', 'seq', 'timestamp', 'updatedAt'])
          && incoming().keys().hasOnly([
            'id', 'projectId', 'ownerId', 'role', 'content', 'seq', 'timestamp',
            'changedFiles', 'searchOutcome', 'updatedAt'
          ])
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/projects/$(projectId))
          && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
        allow update: if isVerifiedUser()
          && isValidId(projectId)
          && isValidId(messageId)
          && isValidProjectMessage(incoming(), projectId, messageId)
          && incoming().id == existing().id
          && incoming().projectId == existing().projectId
          && incoming().ownerId == existing().ownerId
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'role', 'content', 'seq', 'timestamp', 'changedFiles', 'searchOutcome', 'updatedAt'
          ])
          && exists(/databases/$(database)/documents/projects/$(projectId))
          && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
        allow delete: if isValidId(projectId)
          && isValidId(messageId)
          && isVerifiedUser()
          && exists(/databases/$(database)/documents/projects/$(projectId))
          && get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid;
      }
    }

    // Deployments collection (publicly readable by individual slug; owner-restricted list & writes)
    match /deployments/{slug} {
      allow get: if isValidId(slug);
      allow list: if isVerifiedUser()
        && resource.data.ownerId == request.auth.uid;
      allow create: if isVerifiedUser()
        && isValidId(slug)
        && isValidDeployment(incoming(), slug)
        && incoming().keys().hasAll(['slug', 'ownerId', 'projectId', 'title', 'htmlBundle', 'createdAt', 'updatedAt'])
        && incoming().keys().hasOnly(['slug', 'ownerId', 'projectId', 'title', 'htmlBundle', 'createdAt', 'updatedAt'])
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/projects/$(incoming().projectId))
        && get(/databases/$(database)/documents/projects/$(incoming().projectId)).data.ownerId == request.auth.uid;
      allow update: if isVerifiedUser()
        && isValidId(slug)
        && existing().ownerId == request.auth.uid
        && isValidDeployment(incoming(), slug)
        && incoming().slug == existing().slug
        && incoming().ownerId == existing().ownerId
        && incoming().projectId == existing().projectId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'htmlBundle', 'updatedAt']);
      allow delete: if isValidId(slug)
        && isVerifiedUser()
        && existing().ownerId == request.auth.uid;
    }
  }
}
